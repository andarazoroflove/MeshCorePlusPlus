#include <windows.h>

// Primary executable icon (Explorer, Desktop, Taskbar, Alt-Tab, Titlebar)
101 ICON "meshcore.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,17,1,0
PRODUCTVERSION  1,17,1,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "MeshCore++ Tactical Systems\0"
            VALUE "FileDescription",  "MeshCore++ Native C++20 Tactical LoRa Mesh IRC & 256-Bucket Sniffer\0"
            VALUE "FileVersion",      "1.17.1.0\0"
            VALUE "InternalName",     "MeshCore++\0"
            VALUE "OriginalFilename", "MeshCore++.exe\0"
            VALUE "ProductName",      "MeshCore++\0"
            VALUE "ProductVersion",   "1.17.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

